<Window x:Class="VideoSplitter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VideoSplitter v1.1.0"
        Icon="Assets/VideoSplitter.ico"
        Height="860"
        Width="800"
        MinHeight="650"
        MinWidth="700"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F7FA">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Background="White"
                    Margin="30"
                    Padding="30"
                    CornerRadius="12">

                <StackPanel>

                    <!-- ÜST BAŞLIK + DİL -->
                    <Grid Margin="0,0,0,30">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock x:Name="AppTitleTextBlock"
                                       Text="Video Splitter"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#202124"/>

                            <TextBlock x:Name="SubtitleTextBlock"
                                       Text="Videolarınızı kalite kaybı olmadan parçalara bölün."
                                       FontSize="14"
                                       Foreground="#6B7280"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top">

                            <Button x:Name="TurkishButton"
                                    Content="TR"
                                    Width="46"
                                    Height="32"
                                    Margin="0,0,6,0"
                                    FontWeight="Bold"
                                    Click="TurkishButton_Click"/>

                            <Button x:Name="EnglishButton"
                                    Content="EN"
                                    Width="46"
                                    Height="32"
                                    Click="EnglishButton_Click"/>

                            <Button x:Name="AboutButton"
                                    Content="Hakkında"
                                    Width="92"
                                    Height="32"
                                    Margin="8,0,0,0"
                                    Click="AboutButton_Click"/>

                        </StackPanel>

                    </Grid>

                    <!-- VIDEO DOSYASI -->
                    <TextBlock x:Name="VideoFileLabel"
                               Text="Video Dosyası"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,7"/>

                    <Grid Margin="0,0,0,22">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="VideoPathTextBox"
                                 Height="38"
                                 VerticalContentAlignment="Center"
                                 Padding="10,0"
                                 IsReadOnly="True"/>

                        <Button x:Name="SelectVideoButton"
                                Grid.Column="1"
                                Content="Video Seç"
                                Height="38"
                                Margin="10,0,0,0"
                                FontWeight="SemiBold"
                                Click="SelectVideoButton_Click"/>

                    </Grid>

                    <!-- MAKSİMUM PART BOYUTU -->
                    <TextBlock x:Name="PartSizeLabel"
                               Text="Maksimum Part Boyutu"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,7"/>

                    <Grid Margin="0,0,0,22">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="PartSizeTextBox"
                                 Text="1900"
                                 Height="38"
                                 VerticalContentAlignment="Center"
                                 Padding="10,0"/>

                        <ComboBox x:Name="SizeUnitComboBox"
                                  Grid.Column="1"
                                  Height="38"
                                  Margin="10,0,0,0"
                                  SelectedIndex="0">

                            <ComboBoxItem Content="MB"/>
                            <ComboBoxItem Content="GB"/>

                        </ComboBox>

                        <TextBlock x:Name="PartSizeHintTextBlock"
                                   Grid.Column="2"
                                   Text="Bu değer maksimum sınırdır."
                                   VerticalAlignment="Center"
                                   Foreground="#808080"
                                   Margin="15,0,0,0"/>

                    </Grid>

                    <!-- PART ETİKETİ -->
                    <TextBlock x:Name="PartSuffixLabel"
                               Text="Part Etiketi"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,7"/>

                    <Grid Margin="0,0,0,22">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="PartSuffixTextBox"
                                 Text="PRT"
                                 Height="38"
                                 VerticalContentAlignment="Center"
                                 Padding="10,0"/>

                        <TextBlock x:Name="PartSuffixHintTextBlock"
                                   Grid.Column="1"
                                   Text="Örn: video-PRT1.mp4"
                                   VerticalAlignment="Center"
                                   Foreground="#808080"
                                   Margin="15,0,0,0"/>

                    </Grid>

                    <!-- ÇIKTI KLASÖRÜ -->
                    <TextBlock x:Name="OutputFolderLabel"
                               Text="Çıktı Klasörü"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,7"/>

                    <Grid Margin="0,0,0,22">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="OutputPathTextBox"
                                 Height="38"
                                 VerticalContentAlignment="Center"
                                 Padding="10,0"
                                 IsReadOnly="True"
                                 Text="Video ile aynı klasör"/>

                        <Button x:Name="SelectOutputButton"
                                Grid.Column="1"
                                Content="Klasör Seç"
                                Height="38"
                                Margin="10,0,0,0"
                                Click="SelectOutputButton_Click"/>

                    </Grid>

                    <!-- TELEGRAM -->
                    <Border Background="#F8FAFC"
                            BorderBrush="#E1E5EA"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,22">

                        <StackPanel>

                            <TextBlock x:Name="TelegramTitleTextBlock"
                                       Text="Telegram"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#202124"
                                       Margin="0,0,0,12"/>

                            <CheckBox x:Name="TelegramUploadCheckBox"
                                      Content="Bölme bittikten sonra Telegram'a yükle"
                                      FontSize="14"
                                      VerticalContentAlignment="Center"
                                      Checked="TelegramUploadCheckBox_Changed"
                                      Unchecked="TelegramUploadCheckBox_Changed"/>

                            <StackPanel x:Name="TelegramOptionsPanel"
                                        Margin="0,18,0,0"
                                        IsEnabled="False">

                                <!-- BAĞLANTI -->
                                <Grid Margin="0,0,0,14">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="TelegramAccountLabel"
                                               Grid.Column="0"
                                               Text="Telegram Hesabı"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <TextBlock x:Name="TelegramConnectionStatusTextBlock"
                                               Grid.Column="1"
                                               Text="Bağlı değil"
                                               Foreground="#6B7280"
                                               VerticalAlignment="Center"/>

                                    <Button x:Name="TelegramSettingsButton"
                                            Grid.Column="2"
                                            Content="Telegram Ayarları"
                                            Height="34"
                                            Click="TelegramSettingsButton_Click"/>

                                </Grid>

                                <!-- HEDEF -->
                                <Grid Margin="0,0,0,14">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="TelegramTargetLabel"
                                               Grid.Column="0"
                                               Text="Hedef"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <ComboBox x:Name="TelegramTargetComboBox"
                                              Grid.Column="1"
                                              Height="34"
                                              IsEnabled="False">

                                        <ComboBoxItem x:Name="TelegramConnectFirstItem"
                                                      Content="Önce Telegram hesabını bağlayın"
                                                      IsSelected="True"/>

                                    </ComboBox>

                                </Grid>

                                <!-- PARALEL TRANSFER -->
                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="TelegramParallelLabel"
                                               Grid.Column="0"
                                               Text="Paralel Transfer"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <ComboBox x:Name="TelegramParallelComboBox"
                                              Grid.Column="1"
                                              Height="34"
                                              SelectedIndex="0">

                                        <ComboBoxItem x:Name="TelegramParallelAutoItem"
                                                      Content="Otomatik (4)"/>

                                        <ComboBoxItem Content="1"/>
                                        <ComboBoxItem Content="2"/>
                                        <ComboBoxItem Content="4"/>
                                        <ComboBoxItem Content="8"/>

                                    </ComboBox>

                                    <TextBlock x:Name="TelegramParallelHintTextBlock"
                                               Grid.Column="2"
                                               Text="Testimizde 4 en iyi sonucu verdi."
                                               Foreground="#808080"
                                               VerticalAlignment="Center"
                                               Margin="15,0,0,0"/>

                                </Grid>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                    <!-- VİDEOYU BÖL -->
                    <Button x:Name="SplitButton"
                            Content="VİDEOYU BÖL"
                            Height="48"
                            FontSize="16"
                            FontWeight="Bold"
                            Margin="0,0,0,20"
                            Click="SplitButton_Click"/>

                    <!-- PROGRESS -->
                    <ProgressBar x:Name="ProgressBar"
                                 Height="18"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"/>

                    <Grid Margin="0,10,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PercentTextBlock"
                                   Grid.Column="0"
                                   Text="0%"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   HorizontalAlignment="Left"/>

                        <TextBlock x:Name="ElapsedTextBlock"
                                   Grid.Column="1"
                                   Text="Geçen: 00:00"
                                   Foreground="#6B7280"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="RemainingTextBlock"
                                   Grid.Column="2"
                                   Text="Kalan: --:--"
                                   Foreground="#6B7280"
                                   HorizontalAlignment="Right"/>

                    </Grid>

                    <TextBlock x:Name="StatusTextBlock"
                               Text="Hazır"
                               HorizontalAlignment="Center"
                               Foreground="#6B7280"
                               Margin="0,10,0,0"/>

                    <!-- ALT BUTONLAR -->
                    <Grid Margin="0,20,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="CancelButton"
                                Grid.Column="0"
                                Content="İPTAL ET"
                                Height="40"
                                Margin="0,0,5,0"
                                IsEnabled="False"
                                Click="CancelButton_Click"/>

                        <Button x:Name="OpenOutputButton"
                                Grid.Column="1"
                                Content="ÇIKTI KLASÖRÜNÜ AÇ"
                                Height="40"
                                Margin="5,0,0,0"
                                IsEnabled="False"
                                Click="OpenOutputButton_Click"/>

                    </Grid>

                    <!-- UYGULAMA ALT BİLGİ -->
                    <Border BorderBrush="#E5E7EB"
                            BorderThickness="0,1,0,0"
                            Margin="0,24,0,0"
                            Padding="0,15,0,0">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <TextBlock x:Name="FooterVersionTextBlock"
                                           Text="v1.1.0"
                                           FontWeight="SemiBold"
                                           Foreground="#6B7280"/>

                                <TextBlock Text="  •  "
                                           Foreground="#9CA3AF"/>

                                <TextBlock Text="Cenk Berk Güngör"
                                           Foreground="#6B7280"/>

                            </StackPanel>

                            <Button x:Name="FooterGitHubButton"
                                    Grid.Column="1"
                                    Content="GitHub"
                                    Padding="10,4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#2563EB"
                                    Cursor="Hand"
                                    Click="FooterGitHubButton_Click"/>

                        </Grid>

                    </Border>

                </StackPanel>

            </Border>

        </ScrollViewer>

    </Grid>

</Window>