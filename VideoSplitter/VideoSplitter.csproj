<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>Cenk Berk Güngör</Authors>
    <Company>Cenk Berk Güngör</Company>
    <Product>VideoSplitter</Product>
    <Description>Split videos without re-encoding and optionally upload the parts to Telegram.</Description>
    <RepositoryUrl>https://github.com/cenkberkgungor/TelegramVideoSplitter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ApplicationIcon>Assets\VideoSplitter.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="FFmpeg\ffmpeg.exe" />
    <None Remove="FFmpeg\ffprobe.exe" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="FFmpeg\ffmpeg.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="FFmpeg\ffprobe.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\VideoSplitterLogo.png" />
    <Resource Include="Assets\VideoSplitterIcon.png" />
    <Resource Include="Assets\VideoSplitter.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WTelegramClient" Version="4.4.8" />
  </ItemGroup>

</Project>
