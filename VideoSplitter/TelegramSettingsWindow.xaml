<Window x:Class="VideoSplitter.TelegramSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Telegram Ayarları"
        Height="690"
        Width="620"
        MinHeight="650"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Grid Background="#F5F7FA">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Background="White"
                    Margin="24"
                    Padding="28"
                    CornerRadius="12">

                <StackPanel>

                    <!-- BAŞLIK -->
                    <Grid Margin="0,0,0,26">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock x:Name="TitleTextBlock"
                                       Text="Telegram Ayarları"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#202124"/>

                            <TextBlock x:Name="SubtitleTextBlock"
                                       Text="Telegram hesabınızı Video Splitter'a bağlayın."
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top">

                            <Button x:Name="TurkishButton"
                                    Content="TR"
                                    Width="44"
                                    Height="30"
                                    Margin="0,0,6,0"
                                    FontWeight="Bold"
                                    Click="TurkishButton_Click"/>

                            <Button x:Name="EnglishButton"
                                    Content="EN"
                                    Width="44"
                                    Height="30"
                                    Click="EnglishButton_Click"/>

                        </StackPanel>

                    </Grid>

                    <!-- API ID -->
                    <TextBlock x:Name="ApiIdLabel"
                               Text="API ID"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="ApiIdTextBox"
                             Height="38"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,17"/>

                    <!-- API HASH -->
                    <TextBlock x:Name="ApiHashLabel"
                               Text="API Hash"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <PasswordBox x:Name="ApiHashPasswordBox"
                                 Height="38"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,0,17"/>

                    <!-- TELEFON -->
                    <TextBlock x:Name="PhoneLabel"
                               Text="Telefon Numarası"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="PhoneTextBox"
                             Height="38"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,6"/>

                    <TextBlock x:Name="PhoneHintTextBlock"
                               Text="Uluslararası format kullanın. Örn: +905xxxxxxxxx"
                               Foreground="#808080"
                               FontSize="12"
                               Margin="0,0,0,20"/>

                    <!-- BAĞLAN -->
                    <Button x:Name="ConnectButton"
                            Content="TELEGRAM'A BAĞLAN"
                            Height="44"
                            FontWeight="Bold"
                            FontSize="14"
                            Click="ConnectButton_Click"/>

                    <!-- DURUM -->
                    <Border Background="#F8FAFC"
                            BorderBrush="#E1E5EA"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,18,0,0">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="StatusTitleTextBlock"
                                       Grid.Column="0"
                                       Text="Durum:"
                                       FontWeight="SemiBold"
                                       Margin="0,0,10,0"/>

                            <TextBlock x:Name="StatusTextBlock"
                                       Grid.Column="1"
                                       Text="Bağlı değil"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap"/>

                        </Grid>

                    </Border>

                    <!-- DOĞRULAMA / 2FA -->
                    <Border x:Name="LoginStepPanel"
                            Visibility="Collapsed"
                            Background="#F8FAFC"
                            BorderBrush="#E1E5EA"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16"
                            Margin="0,18,0,0">

                        <StackPanel>

                            <TextBlock x:Name="LoginStepLabel"
                                       Text="Telegram doğrulama kodu"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <TextBox x:Name="LoginValueTextBox"
                                     Height="38"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"/>

                            <PasswordBox x:Name="LoginValuePasswordBox"
                                         Height="38"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         Visibility="Collapsed"/>

                            <TextBlock x:Name="LoginStepHintTextBlock"
                                       Text=""
                                       Foreground="#808080"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,12"/>

                            <Button x:Name="ContinueLoginButton"
                                    Content="DEVAM ET"
                                    Height="38"
                                    FontWeight="SemiBold"
                                    Click="ContinueLoginButton_Click"/>

                        </StackPanel>

                    </Border>

                    <!-- GÜVENLİK -->
                    <Border Background="#F8FAFC"
                            BorderBrush="#E1E5EA"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,18,0,0">

                        <TextBlock x:Name="SecurityInfoTextBlock"
                                   Text="API bilgileriniz bu Windows kullanıcısına bağlı olarak şifrelenir ve yalnızca bu bilgisayarda saklanır."
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>

                    </Border>

                    <!-- KAPAT -->
                    <Button x:Name="CloseButton"
                            Content="KAPAT"
                            Height="40"
                            Margin="0,20,0,0"
                            Click="CloseButton_Click"/>

                </StackPanel>

            </Border>

        </ScrollViewer>

    </Grid>

</Window>